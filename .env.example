# Sao chép thành .env rồi tự điền giá trị. Không đưa .env lên chỗ chia sẻ.

# AI viết kịch bản (chọn trong giao diện: Ollama hoặc Gemini)
KV_OLLAMA_URL=http://127.0.0.1:11434
KV_OLLAMA_MODEL=gemma3
KV_OLLAMA_TIMEOUT_SECONDS=240

KV_GEMINI_API_KEY=
# gemini-2.5-flash đã ngừng cho người dùng mới (API báo 404); Google đề xuất gemini-3.8-flash
KV_GEMINI_MODEL=gemini-3.8-flash
# Model tạo ảnh AI cho cảnh không tìm được ảnh Wikimedia
KV_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
KV_GEMINI_TIMEOUT_SECONDS=90

# Thư mục lưu các lần tạo video (mặc định: ./output)
KV_OUTPUT_DIR=
# User-Agent khi gọi Wikimedia Commons; có thể thêm thông tin liên hệ của bạn theo chính sách Wikimedia
KV_HTTP_USER_AGENT=
# Font hỗ trợ tiếng Việt cho chữ trên video (mặc định: C:/Windows/Fonts/arial.ttf)
KV_VIDEO_FONT=
